# Copy to deploy.test.env and adjust for your host (236 test stack defaults).
# Source before starting viknow3: set -a && source config/deploy.test.env && set +a

VIKNOW_HYPERRAG_CONFIG=config/hyperrag.yml
VIKNOW_HYPERRAG_REPO_ROOT=external/HyperRAG
VIKNOW_STATE_DIR=/tmp/viknow3-hyperrag-state
VIKNOW3_DATA_DIR=/data/viknow

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=viknow2

REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_USERNAME=viknow
REDIS_PASSWORD=
REDIS_DATABASE=0

NEO4J_URI=neo4j://127.0.0.1:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

VIKNOW_PRIVATE_BASE_URL=
VIKNOW_PRIVATE_API_KEY=
VIKNOW_PRIVATE_MODEL=
VIKNOW_EMBEDDING_BASE_URL=
VIKNOW_EMBEDDING_API_KEY=
VIKNOW_EMBEDDING_MODEL=
HYPERRAG_RERANK_BASE_URL=
HYPERRAG_RERANK_API_KEY=
HYPERRAG_RERANK_MODEL=

HYPERRAG_LD_LIBRARY_PATH=
HYPERRAG_JOB_LOG_DIR=/tmp/viknow3-job-logs
HYPERRAG_LOG_LEVEL=INFO
HYPERRAG_PROMPT_ENV=test
VIKNOW_UNIFIED_SCHEDULER_ENABLED=true
