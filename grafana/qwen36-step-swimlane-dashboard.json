      {
        "id": 100,
        "type": "row",
        "title": "泳道 1 · 请求生命周期（CPU → 调度 → GPU 一步）",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
        "collapsed": false,
        "panels": []
