# =============================================================================
# jinhe 客户现场 deploy.env
# =============================================================================
# 配合 config/jinhe/docker-compose.yml（接入已有 Docker 容器网络）使用。
#
# 填写说明
#   - 默认值按「容器网络 + compose 服务名」（redis:6379，不是宿主机 16379）
#   - 密钥段必须现场填写；仓库模板保持空值，勿提交真实密码
#   - 236 联调走 host.docker.internal 时，见各行「236：」注释
#
# compose 相关（shell export，不写在本文件）
#   VIKNOW_DATA_NETWORK   data 栈 Docker 网络名，如 customer-data_default
#   VIKNOW_IMAGE          镜像 tag
#   VIKNOW_HOST_PORT      对外端口，默认 8000
#   VIKNOW_STATE_VOLUME   状态卷名，默认 viknow_jinhe_state
# =============================================================================

# --- 开关 / 路径 ---
VIKNOW_PERSISTENCE_BACKEND=postgres          # 持久化：postgres | sqlite
VIKNOW_UNIFIED_SCHEDULER_ENABLED=true        # 统一调度；依赖 Redis
VIKNOW_FILES_ROOT=/data/viknow               # 业务文件根；compose ./data → /data
VIKNOW_SESSION_SCHEMA=viknow_session         # PG schema；多实例同库可改前缀
VIKNOW_CHECKPOINT_SCHEMA=viknow_checkpoint   # checkpoint 表 schema
VIKNOW_MEMORY_SCHEMA=viknow_memory           # memory 表 schema
VIKNOW_SCHEDULER_SCHEMA=viknow_scheduler     # scheduler 表 schema
VIKNOW_LANGFUSE_ENABLED=false                # jinhe 关 Langfuse；须与 app.yaml 一致
VIKNOW_LANGFUSE_HOST=http://test.ai.qingxiang.tech:3000  # 关闭时可忽略
VIKNOW_OTEL_ENABLED=false                    # 无 Jaeger 保持 false
VIKNOW_OTEL_SERVICE_NAME=viknow2-jinhe       # OTEL 服务名（启用 OTEL 时）
VIKNOW_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318   # 236：host.docker.internal:4318
HYPERRAG_PROMPT_ENV=jinhe                    # 必须 jinhe；对应 config/jinhe 提示词
HYPERRAG_JOB_LOG_DIR=/data/viknow/logs/job_logs            # HyperRAG 任务日志目录
HYPERRAG_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
HYPERRAG_LD_LIBRARY_PATH=                    # GPU/cuDNN 库路径；无 GPU 留空

# --- 存储拓扑（中间件）---
# 容器网：HOST=services 名，PORT=容器内端口
POSTGRES_HOST=postgres                       # 236：host.docker.internal
POSTGRES_PORT=5432                           # 236：15432
POSTGRES_USER=postgres                       # PG 用户名
POSTGRES_DATABASE=viknow2                    # PG 库名
MINIO_ENDPOINT=minio:9000                    # 236：host.docker.internal:19000
NEO4J_URI=neo4j://neo4j:7687                 # 236：neo4j://host.docker.internal:17687
NEO4J_USERNAME=neo4j                         # Neo4j 用户名
REDIS_HOST=redis                             # 236：host.docker.internal
REDIS_PORT=6379                              # 236：16379
REDIS_USERNAME=viknow                        # Redis ACL 用户；无 ACL 可留空
REDIS_DATABASE=0                             # db0=leader lease；5177 联调用 2

# --- JuiceFS 元数据 PG（通常与业务 PG 同实例）---
JUICEFS_POSTGRES_HOST=postgres               # 236：host.docker.internal
JUICEFS_POSTGRES_PORT=5432                   # 236：15432
JUICEFS_POSTGRES_USER=postgres
JUICEFS_POSTGRES_DATABASE=viknow2
JUICEFS_SCHEMA=viknow_juicefs                # JuiceFS 元数据 schema

# --- 可选监控 / NPM（无则留空）---
VIKNOW_PROMETHEUS_BASE_URL=                  # 236：http://host.docker.internal:9099
VIKNOW_VLLM_MONITOR_BASE_URL=                # 236：http://host.docker.internal:8500
VIKNOW_NPM_BASE_URL=                         # 236：http://host.docker.internal:8081/api

# --- 模型 / LiteLLM（客户必填）---
VIKNOW_PRIVATE_MODEL=vllm/Qwen/Qwen3.6-35B-A3B-FP8         # 主聊天模型名
VIKNOW_PRIVATE_BASE_URL=https://客户-liteLLM地址/v1        # 客户 LiteLLM /v1 根地址
VIKNOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1  # 硅基流动（若用）
VIKNOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
VIKNOW_EMBEDDING_BASE_URL=http://embedding:8611/v1         # 236：ai.qingxiang.tech:8601
HYPERRAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
HYPERRAG_RERANK_BASE_URL=http://rerank:8602/v1             # 236：ai.qingxiang.tech:8602
HYPERRAG_MINERU_VL_MODEL_NAME=vllm/mineru    # 文档解析 VL 模型
HYPERRAG_MINERU_PROCESSING_WINDOW_SIZE=1     # MinerU 批处理窗口

# --- 密钥（现场填写；仓库空）---
VIKNOW_ADMIN_PASSWORD=                       # 管理后台初始密码
POSTGRES_PASSWORD=                           # PG 密码
JUICEFS_POSTGRES_PASSWORD=                   # 通常同 POSTGRES_PASSWORD
NEO4J_PASSWORD=                              # Neo4j 密码
MINIO_ACCESS_KEY=                            # Minio access key
MINIO_SECRET_KEY=                            # Minio secret key
ACTIO_SERVER_URL=http://actio:8600           # 236：host.docker.internal:8870
ACTIO_API_KEY=                               # Actio 服务 API Key
VIKNOW_PRIVATE_API_KEY=                      # LiteLLM / private provider Key
VIKNOW_SILICONFLOW_API_KEY=                  # 硅基流动 Key
VIKNOW_EMBEDDING_API_KEY=                    # Embedding 服务 Key
HYPERRAG_RERANK_API_KEY=                     # Rerank 服务 Key
VIKNOW_LANGFUSE_PUBLIC_KEY=                  # jinhe 关闭可留空
VIKNOW_LANGFUSE_SECRET_KEY=
VIKNOW_LANGFUSE_USAGE_PUSH_TOKEN=
VIKNOW_NPM_IDENTITY=                         # NPM 鉴权；无则留空
VIKNOW_NPM_SECRET=
REDIS_PASSWORD=                              # Redis 密码

# --- 飞书 Wiki 同步（可选）---
VIKNOW_FEISHU_ENABLED=true                   # 不用飞书改 false
FEISHU_APP_ID=                               # 飞书应用 App ID
FEISHU_APP_SECRET=                           # 飞书应用 Secret
FEISHU_SPACE_ID=                             # Wiki 知识库 space_id
FEISHU_TENANT_HOST=castmeta.feishu.cn        # 租户域名
