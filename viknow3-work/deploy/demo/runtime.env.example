# Copy to host runtime.env (DSN secrets: deploy/demo/pg-demo.env.example -> pg-demo.env; ops: ~/.viknow3/ops.env)

VIKNOW_HOST=0.0.0.0
VIKNOW_PORT=5197
VIKNOW_STATE_DIR=/tmp/viknow3-state
VIKNOW3_DATA_DIR=/data/viknow3

# HyperRAG: config from viknow_ops only — do not set VIKNOW_HYPERRAG_CONFIG

VIKNOW3_APP_KEY=dev-app-key
VIKNOW3_CHAT_API_KEY=
VIKNOW3_EMBED_API_KEY=
