# Copy to e.g. ~/viknow207.host.env — never commit real values.

# --- 207 对外 IP（Playground / storage CORS）---
VIKNOW207_HOST_IP=10.168.1.207

# --- Infra (docker-compose.infra.yml) ---
POSTGRES_PASSWORD=change-me-ops-pg
REDIS_PASSWORD=change-me-redis
# Neo4j: NEO4J_AUTH=neo4j/<password>
NEO4J_PASSWORD=change-me-neo4j
VIKNOW_PG_PORT=16432
VIKNOW_REDIS_PORT=16479
VIKNOW_NEO4J_HTTP_PORT=17474
VIKNOW_NEO4J_BOLT_PORT=17487

# --- viknow-storage ---
STORAGE_TOKEN=change-me-storage-token
VIKNOW_STORAGE_HTTP_PORT=5219
# Actio on 236 fetches grant URLs; use 236 nginx → SSH tunnel → this host (see deploy/236/storage-proxy-207).
STORAGE_DOWNLOAD_BASE_URL=http://127.0.0.1:5220
VIKNOW_STORAGE_MINIO_DATA=/data/viknow/storage-minio

# --- Playground secrets (also written to ~/viknow-platform/pg-demo.env) ---
VIKNOW_APP_KEY=change-me-app-key
VIKNOW_OPS_SECRET=change-me-fernet-ops-secret

# --- 236 远程服务（从 236 ~/deploy.env 复制非 infra 键到 ~/deploy.env 或此处 export）---
# ACTIO_API_KEY=...
# VIKNOW_PRIVATE_BASE_URL=http://36.103.198.236:...
# VIKNOW_PRIVATE_API_KEY=...
# VIKNOW_EMBEDDING_BASE_URL=http://36.103.198.236:...
# VIKNOW_EMBEDDING_API_KEY=...

# --- 路径 ---
VIKNOW_DATA_DIR=/data/viknow
VIKNOW_PLATFORM_STATE=/home/wuzihan/viknow-platform/state
VIKNOW_PYTHON=/home/wuzihan/viknow-platform/venv312/bin/python
VIKNOW_STORAGE_ROOT=/home/wuzihan/src/viknow-storage

# Playground 镜像（236 build → ACR push；207 只 pull，见 deploy/207/README.md）
# VIKNOW_PLATFORM_IMAGE=registry.cn-hangzhou.aliyuncs.com/litesense/viknow-platform-playground:207-latest

# Playground container env (generated/updated by deploy-207.sh)
VIKNOW207_PLATFORM_ENV=/home/wuzihan/viknow207.platform.env
VIKNOW_STORAGE_GRANT_FETCH_BASE=http://127.0.0.1:5220
