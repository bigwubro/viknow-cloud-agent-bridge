# Compose 插值用（1Panel 编排目录「环境」或本文件）
# 密钥只写在这里；deploy.env 是 ViKnow 容器专用，二者不要混用

VIKNOW_PLATFORM_NETWORK=viknow-platform_data

POSTGRES_USER=postgres
POSTGRES_DATABASE=viknow2
POSTGRES_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME

MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME

# 宿主机映射（可按现场改）
VIKNOW_PG_HOST_PORT=15432
VIKNOW_REDIS_HOST_PORT=16379
VIKNOW_MINIO_API_HOST_PORT=19000
VIKNOW_MINIO_CONSOLE_HOST_PORT=19001
VIKNOW_NEO4J_HTTP_HOST_PORT=17474
VIKNOW_NEO4J_BOLT_HOST_PORT=17687

# 离线 load 后与实际 tag 一致
VIKNOW_PG_IMAGE=viknow/pgvector-textsearch:pg18-trixie-v1.3.1
VIKNOW_REDIS_IMAGE=redis:7-alpine
VIKNOW_MINIO_IMAGE=minio/minio:RELEASE.2024-11-07T00-00-00Z
VIKNOW_NEO4J_IMAGE=neo4j:5-community
