data: {"type":"run_started","run_id":"e42466f1-e3a2-44b3-8d91-c3815ba4ff57","sequence":1,"created_at":"2026-09-20T01:23:44.359425Z","payload":{"session_id":"edd46d79-826c-4d44-bb34-f0f93947537b","run_kind":"production","enabled_tools":["knowledge_discover","uploaded_image_search","query_refine","answer_plan","knowledge_search","video_inspect_2_0","visual_ground","document_inspect","list_video_segments","list_doc_segments"],"enabled_skills":["knowledge-qa-v2","visual-ground"],"library_ids":["default"],"behavior_snapshot":{"schema_version":1,"harness_policy_version":"h1-observe-only","profile":{"id":"viknow-v2","effective_config_sha256":"7f5cedb714e715d916b701f75fd1ab12069e83f62f7b801b7cbfbb033f2d97d1"},"agent_model":{"requested":null,"resolved":"vllm/Qwen/Qwen3.6-35B-A3B-FP8","api_key_env":"VIKNOW_PRIVATE_API_KEY","parameters":{"provider":"openai-compatible","provider_name":"private","base_url":"https://ai.qingxiang.tech:8443/v1","base_url_env":"VIKNOW_PRIVATE_BASE_URL","temperature":0.7,"repetition_penalty":1.0,"max_input_tokens":156000,"timeout_seconds":600.0}},"skills":[{"id":"knowledge-qa-v2","source_path":null,"sha256":"d4baea03a4fb3559b9ea8ebcedf4d690876d351c3b9e85735422dcaa876f58b0","implementation":null,"state":"captured","unavailable_reason":null},{"id":"visual-ground","source_path":null,"sha256":"fac548da1ef2bece2caa0093f9e84b976884d91d47533ebe2450c76f866ee474","implementation":null,"state":"captured","unavailable_reason":null}],"tools":[{"id":"knowledge_discover","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"knowledge_search","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"query_refine","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"answer_plan","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"list_video_segments","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"list_doc_segments","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"video_inspect_2_0","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"document_inspect","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"visual_ground","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null},{"id":"uploaded_image_search","source_path":"site-packages/viknow/core/tools/base.py","sha256":"205e70bb894e2d243f2b19f14c2f97aac6d8d69da0b280ace891d52d67e82caa","implementation":"viknow.core.tools.base.BaseTool.invoke","state":"captured","unavailable_reason":null}],"knowledge_start_state":{"workspace_id":"d72454df-c442-4c11-930c-2fd16d98c08e","use_precompiled_knowledge":true,"selected_knowledge_assets":[],"index_state":"not_yet_observed"}}}}

event: user_message
data: {"type":"user_message","run_id":"e42466f1-e3a2-44b3-8d91-c3815ba4ff57","sequence":2,"created_at":"2026-09-20T01:23:44.365675Z","payload":{"text":"根据知识库中上海唯纳新思资源交付通知书 PDF，用两句话概括交付内容，答案里必须带方括号数字引用如[1]。","session_id":"edd46d79-826c-4d44-bb34-f0f93947537b","user_id":"147cd138-766b-4296-9c7f-795985e8cd51","workspace_id":"d72454df-c442-4c11-930c-2fd16d98c08e","attachments":[]}}

