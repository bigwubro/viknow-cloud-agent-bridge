# =============================================================================
# jinhe 客户现场 deploy.env
# =============================================================================
# 配合 config/jinhe/docker-compose.yml（接入已有 Docker 容器网络）使用。
#
# 填写说明
#   - 默认值按「容器网络 + compose 服务名」（redis:6379，不是宿主机 16379）
#   - 密钥段必须现场填写；仓库模板保持空值，勿提交真实密码
#   - 236 联调走 host.docker.internal 时，见「存储拓扑」段注释对照改
#
# compose 相关（shell export，不写在本文件）
#   VIKNOW_DATA_NETWORK   data 栈 Docker 网络名，如 customer-data_default
#   VIKNOW_IMAGE          镜像 tag
#   VIKNOW_HOST_PORT      对外端口，默认 8000
#   VIKNOW_STATE_VOLUME   状态卷名，默认 viknow_jinhe_state
# =============================================================================

# --- 开关 / 路径 ---
VIKNOW_PERSISTENCE_BACKEND=postgres          # 持久化后端：postgres | sqlite（客户现场 postgres）
VIKNOW_UNIFIED_SCHEDULER_ENABLED=true        # 统一调度器；依赖 Redis
VIKNOW_FILES_ROOT=/data/viknow               # 业务文件根；对应 compose ./data 挂载
VIKNOW_SESSION_SCHEMA=viknow_session         # PG schema 前缀，多实例同库时可改
VIKNOW_CHECKPOINT_SCHEMA=viknow_checkpoint
VIKNOW_MEMORY_SCHEMA=viknow_memory
VIKNOW_SCHEDULER_SCHEMA=viknow_scheduler
VIKNOW_LANGFUSE_ENABLED=false                # jinhe 关闭；须与 app.yaml observability.langfuse.enabled 一致
VIKNOW_LANGFUSE_HOST=http://test.ai.qingxiang.tech:3000
VIKNOW_OTEL_ENABLED=false                    # 客户无 Jaeger 保持 false
VIKNOW_OTEL_SERVICE_NAME=viknow2-jinhe
# 236 联调：http://host.docker.internal:4318
VIKNOW_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318
HYPERRAG_PROMPT_ENV=jinhe                    # 必须 jinhe；与 config/jinhe 提示词包一致
HYPERRAG_JOB_LOG_DIR=/data/viknow/logs/job_logs
HYPERRAG_LOG_LEVEL=INFO
HYPERRAG_LD_LIBRARY_PATH=                    # GPU/cuDNN；无 GPU 留空

# --- 存储拓扑（中间件地址）---
# 容器网络：HOST=compose services 名，PORT=容器内端口
# 236 联调：HOST=host.docker.internal，PORT=宿主机映射（15432/16379/19000/17687）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432                           # 236：15432
POSTGRES_USER=postgres
POSTGRES_DATABASE=viknow2
MINIO_ENDPOINT=minio:9000                    # 236：host.docker.internal:19000
NEO4J_URI=neo4j://neo4j:7687                 # 236：neo4j://host.docker.internal:17687
NEO4J_USERNAME=neo4j
REDIS_HOST=redis
REDIS_PORT=6379                              # 236：16379
REDIS_USERNAME=viknow
REDIS_DATABASE=0                             # db0=leader lease；236 5177 用 2 跳过 lease

# --- JuiceFS 元数据（通常与业务 PG 同实例）---
JUICEFS_POSTGRES_HOST=postgres               # 236：host.docker.internal
JUICEFS_POSTGRES_PORT=5432                   # 236：15432
JUICEFS_POSTGRES_USER=postgres
JUICEFS_POSTGRES_DATABASE=viknow2
JUICEFS_SCHEMA=viknow_juicefs

# --- 可选监控 / NPM（无则留空）---
# 236：host.docker.internal:9099 / :8500 / :8081
VIKNOW_PROMETHEUS_BASE_URL=
VIKNOW_VLLM_MONITOR_BASE_URL=
VIKNOW_NPM_BASE_URL=

# --- 模型 / LiteLLM（客户现场必填）---
VIKNOW_PRIVATE_MODEL=vllm/Qwen/Qwen3.6-35B-A3B-FP8
VIKNOW_PRIVATE_BASE_URL=https://客户-liteLLM地址/v1   # 主聊天；private provider 直连 /v1
VIKNOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
VIKNOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
VIKNOW_EMBEDDING_BASE_URL=http://embedding:8611/v1     # 236：http://ai.qingxiang.tech:8601/v1
HYPERRAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
HYPERRAG_RERANK_BASE_URL=http://rerank:8602/v1         # 236：http://ai.qingxiang.tech:8602/v1
HYPERRAG_MINERU_VL_MODEL_NAME=vllm/mineru
HYPERRAG_MINERU_PROCESSING_WINDOW_SIZE=1

# --- 密钥（现场填写；仓库保持空）---
VIKNOW_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
JUICEFS_POSTGRES_PASSWORD=                   # 通常与 POSTGRES_PASSWORD 相同
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ACTIO_SERVER_URL=http://actio:8600           # 236：http://host.docker.internal:8870
ACTIO_API_KEY=
VIKNOW_PRIVATE_API_KEY=                      # LiteLLM API Key
VIKNOW_SILICONFLOW_API_KEY=
VIKNOW_EMBEDDING_API_KEY=
HYPERRAG_RERANK_API_KEY=
VIKNOW_LANGFUSE_PUBLIC_KEY=
VIKNOW_LANGFUSE_SECRET_KEY=
VIKNOW_LANGFUSE_USAGE_PUSH_TOKEN=
VIKNOW_NPM_IDENTITY=
VIKNOW_NPM_SECRET=
REDIS_PASSWORD=

# --- 飞书 Wiki 同步（可选）---
VIKNOW_FEISHU_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
FEISHU_TENANT_HOST=castmeta.feishu.cn
