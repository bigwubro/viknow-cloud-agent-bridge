{
  "dashboard": {
    "title": "Qwen3.6 Step Swimlane · E / P+D 双预算",
    "uid": "qwen36-step-swimlane",
    "tags": ["qwen36", "vllm", "swimlane", "batch"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
