          "overrides": [
            {"matcher": {"id": "byName", "options": "prefill tokens"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "decode tokens"}, "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "budget 16384"}, "properties": [
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}},
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineWidth", "value": 1}
            ]}
          ]
