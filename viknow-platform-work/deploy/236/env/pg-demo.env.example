# Host DSN bundle (e.g. /home/cursor-agent/viknow-platform/pg-demo.env).
# Used by scripts/deploy-playground-ui.sh and refresh-secrets-from-host.sh — not a fourth deploy file in Git.
# Phase 1 unified knowledge DB: catalog + HyperRAG engine share viknow_knowledge.
# ops postgres_connection.database must match VIKNOW_HYPERRAG_DSN database name.

VIKNOW_ACCESS_DSN=postgresql://viknow_ops:CHANGE_ME@127.0.0.1:16432/viknow_access
VIKNOW_AGENT_DSN=postgresql://viknow_ops:CHANGE_ME@127.0.0.1:16432/viknow_agent
VIKNOW_HYPERRAG_DSN=postgresql://viknow_ops:CHANGE_ME@127.0.0.1:16432/viknow_knowledge
