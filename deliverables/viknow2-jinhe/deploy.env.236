# 236 手工冒烟 deploy.env（compose 可直接引用本文件）
# 规则：监控 → 127.0.0.1 占位；中间件/Actio/HTTP 模型 → 宿主机内网 172.30.57.94
# LiteLLM HTTPS 须用域名（IP + https 会 TLS SNI 失败）
# 与 viknow2-test 共存：REDIS_DATABASE=1，且关闭统一调度（避免非 leader 卡队列）

VIKNOW_PERSISTENCE_BACKEND=postgres
VIKNOW_UNIFIED_SCHEDULER_ENABLED=false
VIKNOW_FILES_ROOT=/data/viknow
VIKNOW_SESSION_SCHEMA=viknow_session
VIKNOW_CHECKPOINT_SCHEMA=viknow_checkpoint
VIKNOW_MEMORY_SCHEMA=viknow_memory
VIKNOW_SCHEDULER_SCHEMA=viknow_scheduler
VIKNOW_LANGFUSE_ENABLED=false
VIKNOW_LANGFUSE_HOST=
VIKNOW_OTEL_ENABLED=false
VIKNOW_OTEL_SERVICE_NAME=viknow2-jinhe-manual
VIKNOW_OTEL_EXPORTER_ENDPOINT=
HYPERRAG_PROMPT_ENV=jinhe
HYPERRAG_JOB_LOG_DIR=/data/viknow/logs/job_logs
HYPERRAG_LOG_LEVEL=INFO
HYPERRAG_LD_LIBRARY_PATH=

POSTGRES_HOST=172.30.57.94
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_DATABASE=viknow2
MINIO_ENDPOINT=172.30.57.94:19000
# 已 format 的卷元数据里是 host.docker.internal；mount --bucket 用 IP 覆盖，无需 extra_hosts
