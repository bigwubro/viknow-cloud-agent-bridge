# =============================================================================
# 236 联调：5177 deploy.env（deploy.actio-manual-5177.env）
# =============================================================================
# 配合 /home/cursor-agent/docker-compose.viknow2-test.manual.yml 使用。
#   - compose 指定 VIKNOW_CONFIG=/opt/viknow/config/jinhe/app.yaml
#   - 须 compose extra_hosts: host.docker.internal:host-gateway
#   - 中间件走 viknow-test-data-* 栈的宿主机映射端口
#
# 本文件含真实密钥，勿提交 Git。现场部署请用 config/jinhe/deploy.env + docker-compose.yml。
# =============================================================================

# --- 开关 / 路径 ---
VIKNOW_PERSISTENCE_BACKEND=postgres
VIKNOW_UNIFIED_SCHEDULER_ENABLED=true
VIKNOW_FILES_ROOT=/data/viknow
VIKNOW_LANGFUSE_ENABLED=false                # jinhe 关闭 Langfuse
VIKNOW_LANGFUSE_HOST=http://test.ai.qingxiang.tech:3000
HYPERRAG_PROMPT_ENV=test                     # 5177 仍 test；与 jinhe app.yaml 混用时的现状
HYPERRAG_JOB_LOG_DIR=/data/viknow/logs/job_logs
HYPERRAG_LOG_LEVEL=INFO
HYPERRAG_LD_LIBRARY_PATH=/data/test/app/nexus-v/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib/

# --- 存储拓扑（host.docker.internal + test-data 映射端口）---
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=15432                          # → viknow-test-data-postgres-1:5432
POSTGRES_USER=postgres
POSTGRES_DATABASE=viknow2
MINIO_ENDPOINT=host.docker.internal:19000    # → viknow-test-data-minio-1:9000
NEO4J_URI=neo4j://host.docker.internal:17687 # → viknow-test-data-neo4j-1:7687
NEO4J_USERNAME=neo4j
REDIS_HOST=host.docker.internal
REDIS_PORT=16379                             # → viknow-test-data-redis-1:6379
REDIS_USERNAME=viknow
REDIS_DATABASE=2                             # 非 0：跳过 leader lease（5177 专用 db）

# --- JuiceFS 元数据 ---
JUICEFS_POSTGRES_HOST=host.docker.internal
JUICEFS_POSTGRES_PORT=15432
JUICEFS_POSTGRES_USER=postgres
JUICEFS_POSTGRES_DATABASE=viknow2
JUICEFS_SCHEMA=viknow_juicefs

# --- 本环境可选服务 ---
VIKNOW_PROMETHEUS_BASE_URL=http://host.docker.internal:9099
VIKNOW_VLLM_MONITOR_BASE_URL=http://host.docker.internal:8500
VIKNOW_NPM_BASE_URL=http://host.docker.internal:8081/api

# --- 模型 / LiteLLM ---
VIKNOW_PRIVATE_MODEL=vllm/Qwen/Qwen3.6-35B-A3B-FP8
VIKNOW_PRIVATE_BASE_URL=https://ai.qingxiang.tech:8443/v1
VIKNOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
VIKNOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
VIKNOW_EMBEDDING_BASE_URL=http://ai.qingxiang.tech:8601/v1
VIKNOW_ASR_MODEL=vllm/whisper-large-v3
VIKNOW_LOCATE_ANYTHING_BASE_URL=http://host.docker.internal:8870/locate
HYPERRAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
HYPERRAG_RERANK_BASE_URL=http://ai.qingxiang.tech:8602/v1
HYPERRAG_MINERU_VL_MODEL_NAME=vllm/mineru
HYPERRAG_MINERU_PROCESSING_WINDOW_SIZE=1

# --- 密钥（236 联调已填；勿提交）---
VIKNOW_ADMIN_PASSWORD=devadmin
POSTGRES_PASSWORD=qx123456
JUICEFS_POSTGRES_PASSWORD=qx123456
NEO4J_PASSWORD=qx123456
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
ACTIO_SERVER_URL=http://host.docker.internal:8870
ACTIO_API_KEY=<现场密钥>
VIKNOW_PRIVATE_API_KEY=<现场密钥>
VIKNOW_SILICONFLOW_API_KEY=<现场密钥>
VIKNOW_EMBEDDING_API_KEY=<现场密钥>
HYPERRAG_RERANK_API_KEY=<现场密钥>
VIKNOW_LANGFUSE_PUBLIC_KEY=
VIKNOW_LANGFUSE_SECRET_KEY=
VIKNOW_LANGFUSE_USAGE_PUSH_TOKEN=
VIKNOW_NPM_IDENTITY=local-dev-skip
VIKNOW_NPM_SECRET=local-dev-skip
REDIS_PASSWORD=QX123456

VIKNOW_FEISHU_ENABLED=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
FEISHU_TENANT_HOST=
