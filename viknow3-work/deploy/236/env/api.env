# ViKnow API (python -m viknow3) — non-secret; see deploy/236/env/ENV.md
VIKNOW_HOST=0.0.0.0
VIKNOW_PORT=5218
VIKNOW_CORS_ORIGINS=http://36.103.198.236:5198

# viknow-storage HTTP gateway (server-side only; MinIO is not exposed to viknow3 or browsers)
VIKNOW_STORAGE_URL=http://127.0.0.1:5219

# Playground demo data paths (on-disk: HyperRAG working dir + scratch + agent sessions; assets live in viknow-storage)
VIKNOW3_DATA_DIR=/data/viknow
VIKNOW3_LIBRARIES_ROOT=/data/viknow/playground/hyperrag-wd
VIKNOW_SCRATCH_DIR=/data/viknow/playground/scratch
VIKNOW_AGENT_WORKSPACE_ROOT=/data/viknow/playground/agent-workspaces
VIKNOW_STATE_DIR=/state
VIKNOW_VENDOR_FILES_ROOT=/state/vendor-files

# MinerU docker wrapper (scripts/mineru-docker-wrapper)
HYPERRAG_TEST_IMAGE=viknow2-catalog-upgrade:hyperrag-test-dd8bf2a6
ACTIO_SERVER_URL=http://127.0.0.1:8600
