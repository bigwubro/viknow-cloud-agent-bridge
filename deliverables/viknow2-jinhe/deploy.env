# =============================================================================
# jinhe 客户现场 deploy.env
# =============================================================================
# 配合 config/jinhe/docker-compose.yml（接入已有 Docker 容器网络）使用。
#
# 填写说明
#   - 下方默认值按「容器网络 + compose 服务名」填写（redis:6379，不是宿主机 16379）
#   - 密钥段必须现场填写；仓库模板保持空值，勿提交真实密码
#   - 若 236 联调走 host.docker.internal，见各段「236 联调」注释
#
# compose 相关环境变量（在 shell export，不写在下面）
#   VIKNOW_DATA_NETWORK   data 栈 Docker 网络名，如 customer-data_default
#   VIKNOW_IMAGE          镜像 tag
#   VIKNOW_HOST_PORT      对外端口，默认 8000
# =============================================================================

# --- 开关 / 路径 ---
VIKNOW_PERSISTENCE_BACKEND=postgres
VIKNOW_UNIFIED_SCHEDULER_ENABLED=true
VIKNOW_FILES_ROOT=/data/viknow
# PG schema 前缀；多实例共用同一 PG 时可改前缀隔离
VIKNOW_SESSION_SCHEMA=viknow_session
VIKNOW_CHECKPOINT_SCHEMA=viknow_checkpoint
VIKNOW_MEMORY_SCHEMA=viknow_memory
VIKNOW_SCHEDULER_SCHEMA=viknow_scheduler
# jinhe：关闭 Langfuse（app.yaml 亦设为 false；仅 env 不够）
VIKNOW_LANGFUSE_ENABLED=false
VIKNOW_LANGFUSE_HOST=http://test.ai.qingxiang.tech:3000
# OTEL/Jaeger：客户现场无则保持 false
VIKNOW_OTEL_ENABLED=false
VIKNOW_OTEL_SERVICE_NAME=viknow2-jinhe
# 236 联调：http://host.docker.internal:4318
VIKNOW_OTEL_EXPORTER_ENDPOINT=http://otel-collector:4318
# 必须 jinhe，与 config/jinhe 提示词包一致
HYPERRAG_PROMPT_ENV=jinhe
HYPERRAG_JOB_LOG_DIR=/data/viknow/logs/job_logs
HYPERRAG_LOG_LEVEL=INFO
# GPU/cuDNN 路径：按现场 nexus/venv 调整；无 GPU 可留空
HYPERRAG_LD_LIBRARY_PATH=

# --- 存储拓扑（中间件地址）---
# 使用 docker-compose.yml 挂 external network 时：
#   - HOST 填 data compose 里 services 名（redis / postgres / minio / neo4j）
#   - PORT 填容器内端口（6379 / 5432 / 9000 / 7687），不是宿主机映射端口
# 236 联调示例（需 compose extra_hosts + host.docker.internal）：
#   POSTGRES_HOST=host.docker.internal  POSTGRES_PORT=15432
#   REDIS_HOST=host.docker.internal     REDIS_PORT=16379
#   MINIO_ENDPOINT=host.docker.internal:19000
#   NEO4J_URI=neo4j://host.docker.internal:17687

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DATABASE=viknow2
MINIO_ENDPOINT=minio:9000
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=viknow
# db0：统一调度 leader lease 需要；多实例共用 Redis 时勿与他人抢 db0
REDIS_DATABASE=0

# --- JuiceFS 元数据（通常与业务 PG 同实例）---
JUICEFS_POSTGRES_HOST=postgres
JUICEFS_POSTGRES_PORT=5432
JUICEFS_POSTGRES_USER=postgres
JUICEFS_POSTGRES_DATABASE=viknow2
JUICEFS_SCHEMA=viknow_juicefs

# --- 可选监控 / NPM（无则留空或删 compose 中相关能力）---
# 236 联调：host.docker.internal:9099 / :8500 / :8081
VIKNOW_PROMETHEUS_BASE_URL=
VIKNOW_VLLM_MONITOR_BASE_URL=
VIKNOW_NPM_BASE_URL=

# --- 模型 / LiteLLM（客户现场必填）---
# 主聊天：private provider 直连客户 LiteLLM OpenAI-compatible /v1，不经 Token Gateway
VIKNOW_PRIVATE_MODEL=vllm/Qwen/Qwen3.6-35B-A3B-FP8
VIKNOW_PRIVATE_BASE_URL=https://客户-liteLLM地址/v1
VIKNOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
VIKNOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
VIKNOW_EMBEDDING_BASE_URL=http://embedding:8611/v1
HYPERRAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
HYPERRAG_RERANK_BASE_URL=http://rerank:8602/v1
HYPERRAG_MINERU_VL_MODEL_NAME=vllm/mineru
HYPERRAG_MINERU_PROCESSING_WINDOW_SIZE=1

# --- 密钥（现场填写；仓库保持空）---
VIKNOW_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
JUICEFS_POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Actio：若 actio 在容器网内，URL 用服务名，如 http://actio:8600
ACTIO_SERVER_URL=http://actio:8600
ACTIO_API_KEY=
VIKNOW_PRIVATE_API_KEY=
VIKNOW_SILICONFLOW_API_KEY=
VIKNOW_EMBEDDING_API_KEY=
HYPERRAG_RERANK_API_KEY=
VIKNOW_LANGFUSE_PUBLIC_KEY=
VIKNOW_LANGFUSE_SECRET_KEY=
VIKNOW_LANGFUSE_USAGE_PUSH_TOKEN=
VIKNOW_NPM_IDENTITY=
VIKNOW_NPM_SECRET=
REDIS_PASSWORD=

# --- 飞书 Wiki 同步（可选）---
VIKNOW_FEISHU_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
FEISHU_TENANT_HOST=castmeta.feishu.cn
