# =============================================================================
# ViKnow jinhe — 客户现场「仅 DB + 本地模型」最小可启动 deploy.env
# =============================================================================
# 适用：现场已部署 Postgres / Redis / MinIO / Neo4j + 本地推理（LiteLLM/vLLM 等），
#       无 Actio、无 Langfuse、无 Prometheus/NPM、无 SiliconFlow 服务。
#
# 用法
#   1. 复制为 deploy.env：cp deploy.on-site-minimal.env deploy.env
#   2. 把下面「现场必改」段落里的 CHANGE_ME / 服务名 改成真实值
#   3. compose 侧 export（不要写进本文件）见文末「启动命令」
#
# 注意
#   - 注释必须单独成行；禁止 KEY=value # 注释
#   - 监控 / Actio / SiliconFlow 段为「合法占位」，仅过启动校验；相关能力不可用
#   - 主对话 / embedding / rerank 必须填真实内网地址，且容器网络内可达
# =============================================================================

# --- 开关 / 路径 ---
VIKNOW_PERSISTENCE_BACKEND=postgres
VIKNOW_UNIFIED_SCHEDULER_ENABLED=true
VIKNOW_FILES_ROOT=/data/viknow
VIKNOW_SESSION_SCHEMA=viknow_session
VIKNOW_CHECKPOINT_SCHEMA=viknow_checkpoint
VIKNOW_MEMORY_SCHEMA=viknow_memory
VIKNOW_SCHEDULER_SCHEMA=viknow_scheduler
VIKNOW_LANGFUSE_ENABLED=false
VIKNOW_LANGFUSE_HOST=
VIKNOW_OTEL_ENABLED=false
VIKNOW_OTEL_SERVICE_NAME=viknow2-jinhe
VIKNOW_OTEL_EXPORTER_ENDPOINT=
HYPERRAG_PROMPT_ENV=jinhe
HYPERRAG_JOB_LOG_DIR=/data/viknow/logs/job_logs
HYPERRAG_LOG_LEVEL=INFO
HYPERRAG_LD_LIBRARY_PATH=

# --- 中间件拓扑（填 data 网络内可达的内网 IP，PORT = 容器内端口）---
POSTGRES_HOST=10.0.0.11
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DATABASE=viknow2
MINIO_ENDPOINT=10.0.0.13:9000
NEO4J_URI=neo4j://10.0.0.14:7687
NEO4J_USERNAME=neo4j
REDIS_HOST=10.0.0.12
REDIS_PORT=6379
REDIS_USERNAME=viknow
REDIS_DATABASE=0

# --- JuiceFS 元数据 PG（与业务 PG 同实例即可）---
JUICEFS_POSTGRES_HOST=10.0.0.11
JUICEFS_POSTGRES_PORT=5432
JUICEFS_POSTGRES_USER=postgres
JUICEFS_POSTGRES_DATABASE=viknow2
JUICEFS_SCHEMA=viknow_juicefs

# =============================================================================
# 现场必改 — 中间件密码（与 data 栈一致）
# =============================================================================
POSTGRES_PASSWORD=CHANGE_ME
JUICEFS_POSTGRES_PASSWORD=CHANGE_ME
NEO4J_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
VIKNOW_ADMIN_PASSWORD=CHANGE_ME

# =============================================================================
# 现场必改 — 本地模型（内网 OpenAI-compatible，/v1 结尾）
# 若 embedding/rerank 也走同一个 LiteLLM，可三个 BASE_URL 填同一地址
# =============================================================================
VIKNOW_PRIVATE_MODEL=vllm/Qwen/Qwen3.6-35B-A3B-FP8
VIKNOW_PRIVATE_BASE_URL=http://10.0.0.20:4000/v1
VIKNOW_PRIVATE_API_KEY=CHANGE_ME_OR_local-no-auth

VIKNOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
VIKNOW_EMBEDDING_BASE_URL=http://10.0.0.21:8611/v1
VIKNOW_EMBEDDING_API_KEY=local-no-auth

HYPERRAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
HYPERRAG_RERANK_BASE_URL=http://10.0.0.22:8602/v1
HYPERRAG_RERANK_API_KEY=local-no-auth

HYPERRAG_MINERU_VL_MODEL_NAME=vllm/mineru
HYPERRAG_MINERU_PROCESSING_WINDOW_SIZE=1

# =============================================================================
# 启动占位 — 监控（不部署也可；仅过 URL 校验，不探测连通性）
# =============================================================================
VIKNOW_PROMETHEUS_BASE_URL=http://127.0.0.1:9099
VIKNOW_VLLM_MONITOR_BASE_URL=http://127.0.0.1:8600
VIKNOW_NPM_BASE_URL=http://127.0.0.1:81

# =============================================================================
# 启动占位 — Actio（不部署也可；视频切分/ASR/OCR 等能力不可用）
# =============================================================================
ACTIO_SERVER_URL=http://127.0.0.1:8600
ACTIO_API_KEY=placeholder-actio-not-deployed

# =============================================================================
# 启动占位 — SiliconFlow（镜像 app.yaml 里备选 model_options 需要非空 env）
# 默认对话走 VIKNOW_PRIVATE_*，不会调用 SiliconFlow
# =============================================================================
VIKNOW_SILICONFLOW_BASE_URL=http://127.0.0.1:8444/v1
VIKNOW_SILICONFLOW_API_KEY=sk-placeholder-not-used

# --- 以下留空即可（jinhe 已关闭 Langfuse / Feishu / NPM 凭证）---
VIKNOW_LANGFUSE_PUBLIC_KEY=
VIKNOW_LANGFUSE_SECRET_KEY=
VIKNOW_LANGFUSE_USAGE_PUSH_TOKEN=
VIKNOW_NPM_IDENTITY=
VIKNOW_NPM_SECRET=
VIKNOW_FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
FEISHU_TENANT_HOST=

# =============================================================================
# 启动命令（在 deploy.env 同目录执行，export 不要写进 env 文件）
# =============================================================================
# export VIKNOW_DATA_NETWORK=viknow-net
# export VIKNOW_IMAGE=viknow2-app:56d8705e5feb
# export VIKNOW_HOST_PORT=8006
# docker compose -f docker-compose.yml up -d
# curl -s -o /dev/null -w '%{http_code}\n' http://127.0.0.1:8006/docs
