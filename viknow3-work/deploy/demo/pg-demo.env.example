# Copy to host pg-demo.env (e.g. /home/cursor-agent/viknow3/pg-demo.env).
# Phase 1 unified knowledge DB: catalog + HyperRAG engine share viknow3_knowledge.
# ops postgres_connection.database must match VIKNOW_HYPERRAG_DSN database name.

VIKNOW_ACCESS_DSN=postgresql://viknow_ops:CHANGE_ME@127.0.0.1:16432/viknow_access
VIKNOW_AGENT_DSN=postgresql://viknow_ops:CHANGE_ME@127.0.0.1:16432/viknow_agent
VIKNOW_HYPERRAG_DSN=postgresql://viknow_ops:CHANGE_ME@127.0.0.1:16432/viknow3_knowledge
VIKNOW_STORAGE_URL=http://127.0.0.1:5219
VIKNOW_STORAGE_BROWSER_URL=http://127.0.0.1:5219
VIKNOW_STORAGE_TOKEN=dev-storage-token
VIKNOW_PORT=5175
VIKNOW_UI_PORT=5198
VIKNOW_PLAYGROUND_API_URL=http://127.0.0.1:5175
VIKNOW_CORS_ORIGINS=http://127.0.0.1:5198
