# test：联调环境。模型名与网关以 private 预发标准为准；拓扑连本机 test 数据套。

# --- 开关 / 路径 ---
VIKNOW_PERSISTENCE_BACKEND=postgres
VIKNOW_UNIFIED_SCHEDULER_ENABLED=true
VIKNOW_FILES_ROOT=/data/viknow
VIKNOW_LANGFUSE_ENABLED=true
VIKNOW_LANGFUSE_HOST=http://test.ai.qingxiang.tech:3000
HYPERRAG_PROMPT_ENV=test
HYPERRAG_JOB_LOG_DIR=/data/viknow/logs/job_logs
HYPERRAG_LOG_LEVEL=INFO
HYPERRAG_LD_LIBRARY_PATH=/data/test/app/nexus-v/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib/

# --- 存储拓扑 ---
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_DATABASE=viknow2
MINIO_ENDPOINT=host.docker.internal:19000
NEO4J_URI=neo4j://host.docker.internal:17687
NEO4J_USERNAME=neo4j
REDIS_HOST=host.docker.internal
REDIS_PORT=16379
REDIS_USERNAME=viknow
REDIS_DATABASE=0

# --- JuiceFS 元数据（与业务 PG 同实例）---
JUICEFS_POSTGRES_HOST=host.docker.internal
JUICEFS_POSTGRES_PORT=15432
JUICEFS_POSTGRES_USER=postgres
JUICEFS_POSTGRES_DATABASE=viknow2
JUICEFS_SCHEMA=viknow_juicefs

# --- 本环境服务 ---
VIKNOW_PROMETHEUS_BASE_URL=http://host.docker.internal:9099
VIKNOW_VLLM_MONITOR_BASE_URL=http://host.docker.internal:8500
VIKNOW_NPM_BASE_URL=http://host.docker.internal:8081/api

# --- 网关 / 模型（本环境 deploy.env 写值；app/hyperrag/actio 只引用变量名）---
VIKNOW_PRIVATE_MODEL=vllm/Qwen/Qwen3.6-35B-A3B-FP8
VIKNOW_PRIVATE_BASE_URL=https://ai.qingxiang.tech:8443/v1
VIKNOW_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
VIKNOW_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
VIKNOW_EMBEDDING_BASE_URL=http://ai.qingxiang.tech:8601/v1
VIKNOW_ASR_MODEL=vllm/whisper-large-v3
VIKNOW_LOCATE_ANYTHING_BASE_URL=${ACTIO_SERVER_URL}/locate
HYPERRAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B
HYPERRAG_RERANK_BASE_URL=http://ai.qingxiang.tech:8602/v1
HYPERRAG_MINERU_VL_MODEL_NAME=vllm/mineru
HYPERRAG_MINERU_PROCESSING_WINDOW_SIZE=1

# --- 密钥（仓库内保持空值；CI 注入或本机填写）---
VIKNOW_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
JUICEFS_POSTGRES_PASSWORD=
NEO4J_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
ACTIO_SERVER_URL=http://host.docker.internal:8600
ACTIO_API_KEY=
VIKNOW_PRIVATE_API_KEY=
VIKNOW_SILICONFLOW_API_KEY=
VIKNOW_EMBEDDING_API_KEY=
HYPERRAG_RERANK_API_KEY=
VIKNOW_LANGFUSE_PUBLIC_KEY=
VIKNOW_LANGFUSE_SECRET_KEY=
VIKNOW_LANGFUSE_USAGE_PUSH_TOKEN=
VIKNOW_NPM_IDENTITY=
VIKNOW_NPM_SECRET=
REDIS_PASSWORD=

VIKNOW_FEISHU_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SPACE_ID=
FEISHU_TENANT_HOST=
