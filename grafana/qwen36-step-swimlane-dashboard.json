          "showUnfilled": true,
          "reduceOptions": {"calcs": ["lastNotNull"]}
        },
        "targets": [
          {"expr": "vllm_batch_total_tokens", "legendFormat": "P+D tokens", "refId": "A"}
        ]
      },
